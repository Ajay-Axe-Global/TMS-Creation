# Copy to .env and fill in. .env is gitignored — never commit it.

FLASK_DEBUG=1          # 1 = Werkzeug dev server (LAN-reachable); 0 = waitress
PORT=5001
WAITRESS_THREADS=16

# Signs login tokens. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRY_HOURS=12

# Encrypts users' TMS passwords + saved browser sessions. Generate once, never rotate casually:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=change-me

# Optional: first-boot admin password. If unset a random one is generated and printed once.
# ADMIN_INITIAL_PASSWORD=

# ── TMS (Business Central) login — helpers/tms_login.py ──
# The company URL users are logged into. Defaults to the Van Moer production company.
# TMS_URL=https://businesscentral.dynamics.com/<tenant>/<environment>?company=<name>
# Phone-call MFA: attempts before giving up, and seconds to answer one call.
# TMS_MFA_MAX_ATTEMPTS=3
# TMS_MFA_ANSWER_TIMEOUT=120
# Browser locale/timezone (BC shows dates per locale; the flow types d/MM/yyyy).
# TMS_LOCALE=en-GB
# TMS_TIMEZONE=Europe/Brussels
# Use a specific Chrome instead of Playwright's bundled Chromium:
# TMS_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CSS selector that means "Business Central has loaded" (tune after the first live run):
# TMS_BC_READY_SELECTOR=[class*="ms-nav-"]

# ── TMS job worker — helpers/tms_worker.py ──
# Browsers working in parallel (0 = this process runs no worker). One user never has two jobs at once.
# TMS_WORKERS=1
# 1 = invisible browser (for a server). Default 0: the window is shown so the login and the
# phone-call step can be watched.
# TMS_HEADLESS=0
# SAFETY SWITCH — default false = DRY RUN: a job signs in, saves the session and reaches the
# Orders list, but never clicks "+ New" (the live TMS may create a blank order when it is
# clicked). Set true only when orders are really meant to be created.
# TMS_CREATE_ENABLED=false
# TMS_POLL_SECONDS=2
# Where dropped documents and failure screenshots are stored (default: ./uploads).
# TMS_UPLOADS_DIR=

# Which engine creates the order once TMS_CREATE_ENABLED=true:
#   js      = your hand-tested script injected into the page (default, proven live)
#   native  = helpers/tms_creation.py, the same flow as native Playwright (validated against an emulator only)
# TMS_FLOW_ENGINE=js
